# CapitalStock Environment Configuration

# Database Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/capitalstock
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_SHOW_SQL=true

# JWT Security Settings
APP_JWT_SECRET=capitalstock_super_secret_jwt_key_that_is_at_least_256_bits_long_for_security
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
